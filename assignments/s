<!DOCTYPE html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <title>Responsive Contact Us Form | CodingLab</title>
    <link rel="stylesheet" href="style.css" />
    <!-- Fontawesome CDN Link -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.2/css/all.min.css" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>
  <body>
    <!-- Best Practice: Using a semantic section tag for the block -->
    <section class="contact">
      <div class="content">
        
        <!-- Left Side: Contact Information Links/Details -->
        <div class="left-side">
          <div class="address details">
            <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
            <h2 class="topic">Address</h2>
            <div class="text-one">Surkhet, NP12</div>
            <div class="text-two">Birendranagar 06</div>
          </div>
          <div class="phone details">
            <i class="fas fa-phone-alt" aria-hidden="true"></i>
            <h2 class="topic">Phone</h2>
            <div class="text-one"><a href="tel:+009898935647">+0098 9893 5647</a></div>
            <div class="text-two"><a href="tel:+009634345678">+0096 3434 5678</a></div>
          </div>
          <div class="email details">
            <i class="fas fa-envelope" aria-hidden="true"></i>
            <h2 class="topic">Email</h2>
            <div class="text-one"><a href="mailto:codinglab@gmail.com">codinglab@gmail.com</a></div>
            <div class="text-two"><a href="mailto:info.codinglab@gmail.com">info.codinglab@gmail.com</a></div>
          </div>
        </div>

        <!-- Right Side: Interactive Form -->
        <div class="right-side">
          <h1 class="topic-text">Send us a message</h1>
          <p>If you have any work from me or any types of queries related to my tutorial, you can send me a message from here. It's my pleasure to help you.</p>
          
          <form action="#">
            <div class="input-box">
              <input type="text" placeholder="Enter your name" required aria-label="Enter your name" />
            </div>
            <div class="input-box">
              <input type="email" placeholder="Enter your email" required aria-label="Enter your email" />
            </div>
            <div class="input-box message-box">
              <textarea placeholder="Enter your message" required aria-label="Enter your message"></textarea>
            </div>
            <div class="button">
              <!-- Best Practice: Changed input button to an actual submit button -->
              <button type="submit">Send Now</button>
            </div>
          </form>
        </div>

      </div>
    </section>
  </body>
</html>
